      "label": "Status",
      "type": "enum",
      "managed_by": "system",
      "primary": true
    },
    {
      "key": "importance",
      "label": "Importance",
      "type": "number"
    },
    {
      "key": "confidence",
      "label": "Confidence",
      "type": "number"
    },
    {
      "key": "trust_source",
      "label": "Source",
      "type": "string"
